# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# These are read by server-side code and Node scripts only (server/, scripts/*.mjs),
# never by the Vite frontends in apps/business or apps/hq — each of those has its
# own .env.example for the (non-secret) values the browser needs.

# --- Hedera (testnet) ---
# portal.hedera.com → Operator Account ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# --- ENS / Sepolia ---
# Free public RPC, no signup — this is the hackathon's SECOND chain, separate from Hedera.
# Shared/rate-limited by everyone on the internet, so swap for a dedicated Alchemy/Infura key
# if it gets flaky (e.g. before the live demo).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# This one EOA plays PayableAgent throughout (TECH-606) — funded with Sepolia testnet ETH
# via a faucet, no real value at stake. Its private key signs the one-time setup script
# (apps/business/scripts/register-agentinsure-eth.mjs, run from a plain Node process, not
# a persistent server) and, separately, the same address connects live via MetaMask in the
# browser to sign the demo's write-then-lock actions. Never committed.
SEPOLIA_WALLET_ADDRESS=
SEPOLIA_PRIVATE_KEY=

# Hackathon's dedicated ENSv2 Sepolia deployment — verified against that deployment's own
# source (Sourcify), not the general public ENSv2 beta. Same values for every teammate, not
# secrets, safe to keep filled in here. Do not swap in viem/ethers' built-in Universal
# Resolver default — it silently resolves against the wrong deployment.
ENS_UNIVERSAL_RESOLVER_ADDRESS=0xd26f2040d083af1cd2962ba303f4bea0c4faf142
ENS_ETH_REGISTRAR_ADDRESS=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENS_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENS_MOCK_USDC_ADDRESS=0xcbfd80f74375c54e545af34788ff465f96f66f05

# --- World ID (Selfie Check) ---
# developer.world.org → Create an app → Configure signer key ("Recommended" quick setup)
# Also create an Action named "file-claim" (Developer Portal → your app → Actions tab),
# credential type Selfie Check — that name is hardcoded in server/src/routes/world.js,
# not read from here, since it's not a secret and never varies by environment.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# "sandbox" while testing against the World ID Sandbox app, "production" for the real thing
WORLD_ENVIRONMENT=sandbox
