# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# One consolidated file for the whole repo — server code, Node scripts, and the
# apps/northbeam frontend (via its vite.config.ts envDir) all read from this same
# root .env.local. Only the VITE_-prefixed vars below are ever exposed to the browser;
# everything else stays server/script-side.

# --- Hedera (testnet) ---
# portal.hedera.com → Operator Account ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# --- ENS / Sepolia ---
# Free public RPC, no signup — this is the hackathon's SECOND chain, separate from Hedera.
# Shared/rate-limited by everyone on the internet, so swap for a dedicated Alchemy/Infura key
# if it gets flaky (e.g. before the live demo).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Public address only — an existing wallet account funded with Sepolia testnet ETH via a
# faucet. Kept for reference; SEPOLIA_PRIVATE_KEY below is the one actually used.
SEPOLIA_WALLET_ADDRESS=
# Hackathon's dedicated ENSv2 Sepolia deployment (UpgradableUniversalResolverProxy) — do not
# use viem/ethers' built-in default, it silently resolves against the wrong deployment.
# Same value for every teammate — not a secret, safe to keep filled in here.
ENS_UNIVERSAL_RESOLVER_ADDRESS=0xd26f2040d083af1cd2962ba303f4bea0c4faf142

# --- ENS spending rules (TECH-606) ---
# Testnet-only — no real value at stake. This one EOA plays PayableAgent throughout: its
# key signs the one-time setup below (scripts/register-agentinsure-eth.mjs, run from
# a plain Node process, not a persistent server), and the SAME address later connects via
# MetaMask in the browser to sign the live write-then-lock demo. Never committed.
SEPOLIA_PRIVATE_KEY=
# Hackathon ENSv2 Sepolia deployment addresses — verified against that deployment's own
# source (Sourcify), not the general public ENSv2 beta. Same values for every teammate.
ENS_ETH_REGISTRAR_ADDRESS=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENS_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENS_MOCK_USDC_ADDRESS=0xcbfd80f74375c54e545af34788ff465f96f66f05
# Exposed to the browser (apps/northbeam) — safe, no secrets. Filled in by
# scripts/register-agentinsure-eth.mjs after it registers agentinsure.eth.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_ENS_RESOLVER_ADDRESS=
VITE_ENS_AGENT_NAME=payableagent.agentinsure.eth

# --- World ID (Selfie Check) ---
# developer.world.org → Create an app → Configure signer key ("Recommended" quick setup)
# Also create an Action named "file-claim" (Developer Portal → your app → Actions tab),
# credential type Selfie Check — that name is hardcoded in server/src/routes/world.js,
# not read from here, since it's not a secret and never varies by environment.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# "sandbox" while testing against the World ID Sandbox app, "production" for the real thing
WORLD_ENVIRONMENT=sandbox

# --- Frontend (apps/northbeam) ---
# Safe to expose to the browser — no secrets, just the shared backend's address.
# Adjust if the shared backend runs somewhere other than localhost.
VITE_API_URL=http://localhost:8787
