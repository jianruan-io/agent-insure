# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# These are read by server-side code only (API routes / functions),
# never by the Vite frontends in apps/northbeam or apps/fidelis.

# --- Hedera (testnet) ---
# portal.hedera.com → Operator Account ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# --- ENS / Sepolia ---
# Alchemy or Infura free tier — this is the hackathon's SECOND chain, separate from Hedera
SEPOLIA_RPC_URL=
# Hackathon's dedicated ENSv2 Sepolia deployment — do not use viem/ethers' built-in default,
# it silently resolves against the wrong Universal Resolver. Pull the current address from
# the deployments page linked on docs.ens.domains before filling this in (see TECH-605).
ENS_UNIVERSAL_RESOLVER_ADDRESS=

# --- World ID (Selfie Check) ---
# developer.world.org → Create an app → Configure signer key ("Recommended" quick setup)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# The Action you create for the claim-filing step, e.g. "file-claim"
WORLD_ACTION_ID=
# "sandbox" while testing against the World ID Sandbox app, "production" for the real thing
WORLD_ENVIRONMENT=sandbox
