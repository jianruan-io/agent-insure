# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# These are read by server-side code only (API routes / functions),
# never by the Vite frontends in apps/northbeam or apps/fidelis.

# --- Hedera (testnet) ---
# portal.hedera.com → Operator Account ID + private key
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=

# --- ENS / Sepolia ---
# Free public RPC, no signup — this is the hackathon's SECOND chain, separate from Hedera.
# Shared/rate-limited by everyone on the internet, so swap for a dedicated Alchemy/Infura key
# if it gets flaky (e.g. before the live demo).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Public address only (never a private key) — an existing wallet account funded with Sepolia
# testnet ETH via a faucet. ENS registration is signed interactively through that wallet
# (e.g. MetaMask), not from a key stored here.
SEPOLIA_WALLET_ADDRESS=
# Hackathon's dedicated ENSv2 Sepolia deployment (UpgradableUniversalResolverProxy) — do not
# use viem/ethers' built-in default, it silently resolves against the wrong deployment.
# Same value for every teammate — not a secret, safe to keep filled in here.
ENS_UNIVERSAL_RESOLVER_ADDRESS=0xd26f2040d083af1cd2962ba303f4bea0c4faf142

# --- World ID (Selfie Check) ---
# developer.world.org → Create an app → Configure signer key ("Recommended" quick setup)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# The Action you create for the claim-filing step, e.g. "file-claim"
WORLD_ACTION_ID=
# "sandbox" while testing against the World ID Sandbox app, "production" for the real thing
WORLD_ENVIRONMENT=sandbox
