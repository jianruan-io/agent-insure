# Safe to expose to the browser — no secrets here, just the shared backend's address.
# Copy to .env.local and adjust if the shared backend runs somewhere other than localhost.
VITE_API_URL=http://localhost:8787

# --- ENS spending rules (TECH-606) ---
# Public RPC for reading spending-rules state — safe to expose to the browser.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Filled in by `node scripts/register-agentinsure-eth.mjs` after it registers agentinsure.eth
# and deploys this project's own resolver proxy — see that script's own header comment.
VITE_ENS_RESOLVER_ADDRESS=
VITE_ENS_AGENT_NAME=payableagent.agentinsure.eth

# --- scripts/register-agentinsure-eth.mjs — one-time setup only, never used by the app ---
# This is a DIFFERENT wallet/mechanism than the root .env.example's SEPOLIA_WALLET_ADDRESS
# (which is signed interactively via MetaMask for the live demo's write/lock actions). This
# key drives only the one-time, off-camera name registration — never committed, gitignored
# via .env.local like every other secret in this repo.
SEPOLIA_PRIVATE_KEY=
# Hackathon ENSv2 Sepolia deployment addresses — verified against that deployment's own
# source (Sourcify), not the general public ENSv2 beta. Same values for every teammate.
ENS_ETH_REGISTRAR_ADDRESS=0x7d1b7f586a62ac3f54b9a396849757814283270b
ENS_PERMISSIONED_RESOLVER_IMPL=0xa9d3814ab151bf6e37a427432795371a8361614e
ENS_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENS_MOCK_USDC_ADDRESS=0xcbfd80f74375c54e545af34788ff465f96f66f05
