# Safe to expose to the browser — no secrets here, just addresses and public config.
# Copy to .env.local and adjust as needed.
VITE_API_URL=http://localhost:8787

# Same RPC as the root .env.example's SEPOLIA_RPC_URL, duplicated here so this app's own
# read-only chain calls (checking spending-rules state) can use it too.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Our own dedicated resolver — the one contract that actually holds PayableAgent's spending
# rules. Not the generic ENS "Universal Resolver" (shared hackathon infra, a different
# contract entirely) — this one is ours alone. Filled in by running
# `node scripts/register-agentinsure-eth.mjs` from this directory — see that script's own
# header comment. Not a secret; safe to expose.
VITE_ENS_AGENT_RESOLVER_ADDRESS=
VITE_ENS_AGENT_NAME=payableagent.agentinsure.eth
